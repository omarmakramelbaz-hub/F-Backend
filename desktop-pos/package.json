{
  "name": "fasakhansta-desktop-pos",
  "version": "0.4.4-preview.50",
  "description": "GO ERP desktop dashboard with durable offline branch orders",
  "main": "src/main.cjs",
  "author": "GO ERP",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "build:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.fasakhansta.dashboard.preview",
    "productName": "GO ERP",
    "beforePack": "./installer-runtime.cjs",
    "afterPack": "./build-uninstaller.cjs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/assets/app.ico",
        "to": "app.ico"
      },
      {
        "from": "runtime-bundle",
        "to": "dashboard-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/app.ico",
      "signExecutable": false
    },
    "nsis": {
      "script": "installer.nsi",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "GO-ERP-Preview-Setup.exe",
      "deleteAppDataOnUninstall": false
    }
  }
}
