{
  "name": "fasakhansta/desktop-dashboard-runtime",
  "type": "project",
  "description": "The original dashboard application embedded in the Windows runtime",
  "keywords": [
    "framework",
    "laravel"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.0",
    "astrotomic/laravel-translatable": "^11.11",
    "barryvdh/laravel-debugbar": "*",
    "barryvdh/laravel-snappy": "^1.0",
    "consoletvs/charts": "6.*",
    "cyrildewit/eloquent-viewable": "^6.1",
    "douyasi/laravel-ckeditor": "~1.0",
    "fideloper/proxy": "^4.2",
    "fruitcake/laravel-cors": "^2.0",
    "google/apiclient": "*",
    "guzzlehttp/guzzle": "^7.0.1",
    "h4cc/wkhtmltoimage-amd64": "0.12.x",
    "h4cc/wkhtmltopdf-amd64": "0.12.x",
    "intervention/image": "^2.7",
    "kreait/firebase-php": "^5.26",
    "kreait/laravel-firebase": "^3.4",
    "laravel/framework": "8.83.29",
    "laravel/tinker": "^2.0",
    "laravelcollective/html": "^6.3",
    "nesbot/carbon": "^2.60",
    "pusher/pusher-php-server": "^7.2",
    "simplesoftwareio/simple-qrcode": "^4.2",
    "spatie/laravel-medialibrary": "^9.12",
    "spatie/laravel-permission": "^5.5",
    "spatie/laravel-settings": "^2.4",
    "stevebauman/location": "^6.5",
    "tymon/jwt-auth": "*"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "platform": {
      "php": "8.2.33"
    }
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    },
    "files": [
      "app/Helpers/helper.php"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ]
  }
}
