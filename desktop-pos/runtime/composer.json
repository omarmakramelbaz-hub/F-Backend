{
  "name": "fasakhansta/desktop-dashboard-runtime",
  "type": "project",
  "description": "The original dashboard application embedded in the Windows runtime",
  "keywords": [
    "framework",
    "laravel"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "astrotomic/laravel-translatable": "^11.17.1",
    "barryvdh/laravel-debugbar": "^3.16.5",
    "barryvdh/laravel-snappy": "^1.0.5",
    "consoletvs/charts": "6.*",
    "cyrildewit/eloquent-viewable": "^7.1.1",
    "douyasi/laravel-ckeditor": "~1.0",
    "google/apiclient": "*",
    "google/gax": "^1.31.0",
    "google/protobuf": "^4.33.6",
    "guzzlehttp/guzzle": "^7.15.2",
    "h4cc/wkhtmltoimage-amd64": "0.12.x",
    "h4cc/wkhtmltopdf-amd64": "0.12.x",
    "intervention/image": "^2.7",
    "kreait/firebase-php": "^7.24.1",
    "kreait/laravel-firebase": "^6.2.0",
    "laravel/framework": "^12.69.0",
    "laravel/tinker": "^2.0",
    "league/flysystem": "^3.35.3",
    "nesbot/carbon": "^3.8.4",
    "pusher/pusher-php-server": "^7.2",
    "simplesoftwareio/simple-qrcode": "^4.2",
    "spatie/laravel-medialibrary": "^11.23.0",
    "spatie/laravel-permission": "^6.25.0",
    "spatie/laravel-settings": "^3.9.0",
    "stevebauman/location": "^7.7.0",
    "tymon/jwt-auth": "^2.3.0"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "platform": {
      "php": "8.2.33"
    }
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    },
    "files": [
      "app/Helpers/helper.php"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ]
  }
}
