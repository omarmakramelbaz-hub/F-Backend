{
  "name": "fasakhansta/desktop-dashboard-runtime",
  "type": "project",
  "description": "The original dashboard application embedded in the Windows runtime",
  "keywords": [
    "framework",
    "laravel"
  ],
  "license": "MIT",
  "require": {
    "astrotomic/laravel-translatable": "^11.11",
    "barryvdh/laravel-snappy": "^1.0",
    "consoletvs/charts": "6.*",
    "cyrildewit/eloquent-viewable": "^7.1",
    "google/apiclient": "^2.20",
    "guzzlehttp/guzzle": "^7.15.2",
    "intervention/image": "^2.7",
    "kreait/firebase-php": "^7.0",
    "kreait/laravel-firebase": "^6.0",
    "laravel/framework": "12.70.0",
    "nesbot/carbon": "^3.0",
    "php": "^8.2",
    "pusher/pusher-php-server": "^7.2",
    "simplesoftwareio/simple-qrcode": "^4.2",
    "spatie/laravel-medialibrary": "^11.23",
    "spatie/laravel-permission": "^6.25",
    "spatie/laravel-settings": "^3.9",
    "stevebauman/location": "^7.7",
    "tymon/jwt-auth": "^2.3"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "platform": {
      "php": "8.2.34"
    }
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    },
    "files": [
      "compatibility.php",
      "app/Helpers/helper.php"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ]
  }
}
