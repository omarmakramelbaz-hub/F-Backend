* text=auto
*.css linguist-vendored
*.scss linguist-vendored
*.js linguist-vendored
CHANGELOG.md export-ignore
public/dashboard/vendor/desktop-external/** -text
# Source-bound browser fixtures compare their actual bytes with the Git blobs on Windows.
tests/desktop_dashboard_runtime/*.php text eol=lf
tests/desktop_dashboard_runtime/*.cjs text eol=lf
tests/desktop_dashboard_runtime/fixtures/*.json text eol=lf
# CRM browser receipts bind the exact source fingerprint helper on Windows.
desktop-pos/src/dashboard-source.cjs text eol=lf
# Preserve upstream notices verbatim and source-bound PDF helper bytes on Windows.
desktop-pos/licenses/wkhtmltox/** -text -whitespace
desktop-pos/src/wkhtmltox-windows.json text eol=lf
tests/desktop_dashboard_runtime/verify-contract-pdf.py text eol=lf
tests/desktop_dashboard_runtime/contract-pdf-parser-test.py text eol=lf
tests/desktop_dashboard_runtime/requirements-pdf-smoke.txt text eol=lf
# The dashboard's GO opening shipped in the desktop app: its release's own bytes, checked file by file on Windows too.
go-erp-desktop/src/main/offline/hologram/** -text
go-erp-desktop/src/renderer/vendor/go-hologram.js -text
