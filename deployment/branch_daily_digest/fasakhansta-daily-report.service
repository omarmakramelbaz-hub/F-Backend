[Unit]
Description=Fasakhansta daily physical-branch inventory and drawer email
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=fasakha
Group=fasakha
WorkingDirectory=/home/fasakha/public_html
Environment=TZ=Africa/Cairo
UMask=0077
ExecStart=/opt/cpanel/ea-php82/root/usr/bin/php /opt/fasakhansta-daily-report/current/report.php --send /etc/fasakhansta-daily-report.json
TimeoutStartSec=300
Restart=on-failure
RestartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/fasakha/.local/state/fasakhansta-daily-report /home/fasakha/public_html/storage
