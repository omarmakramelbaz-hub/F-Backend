+import contextlib
+import importlib.util
+import io
+import json
+import os
+import pathlib
+import re
+import stat
+import subprocess
+import tempfile
+import unittest
+from unittest import mock
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location('customer_addresses_installer',
+                                             ROOT / 'deployment/install_web_customer_addresses.py')
+m = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(m)
+RELEASE = 'f' * 40
+
+
+def baseline(relative):
+    return subprocess.check_output(['git', 'show', m.BASELINE + ':' + relative], cwd=ROOT)
+
+
+class InstallerTests(unittest.TestCase):
+    def test_scope_is_only_existing_three_ui_files(self):
+        self.assertEqual(set(m.PUBLISH_ORDER), {m.HOME, 'public/storefront/storefront.js',
+                                              'public/storefront/storefront.css'})
+        self.assertTrue(all((ROOT / relative).is_file() for relative in m.PUBLISH_ORDER))
+
+    def test_home_merge_preserves_adjacent_independent_seo(self):
+        old = b'<head>\n<title>Original</title>\n<link css v3>\n<script js v3>\n</head>\n<body>\n<form>\n</form>\n</body>\n'
+        reviewed = old.replace(b'v3', b'v4').replace(b'<form>\n', b'<saved-addresses>\n<form>\n')
+        live = old.replace(b'<title>Original</title>', b'@include(seo.head)').replace(
+            b'</head>', b'<link seo.css>\n</head>').replace(b'</form>', b'</form>\n@include(seo.products)')
+        result = m.surgical_patch(live, old, reviewed)
+        expected = live.replace(b'v3', b'v4').replace(b'<form>\n', b'<saved-addresses>\n<form>\n')
+        self.assertEqual(result, expected)
+        self.assertEqual(m.surgical_patch(result, old, reviewed), result)
+
+    def test_real_current_home_merges_independent_seo_and_is_idempotent(self):
+        old = baseline(m.HOME)
+        reviewed = (ROOT / m.HOME).read_bytes()
+        if reviewed == old:
+            self.skipTest('UI changes have not been written yet')
+        live = old.replace(b'    <title>', b'    @include(\'site.seo.independent\')\n    <title>', 1)
+        live = live.replace(b'</head>', b'    <link rel="stylesheet" href="/storefront/seo.css">\n</head>', 1)
+        result = m.surgical_patch(live, old, reviewed)
+        self.assertIn(b"@include('site.seo.independent')", result)
+        self.assertIn(b'/storefront/seo.css', result)
+        self.assertEqual(result.replace(b"    @include('site.seo.independent')\n", b'').replace(
+            b'    <link rel="stylesheet" href="/storefront/seo.css">\n', b''), reviewed)
+        self.assertEqual(m.surgical_patch(result, old, reviewed), result)
+
+    def test_parallel_seo_head_catalog_links_and_hero_survive_install_and_rerun(self):
+        old = baseline(m.HOME)
+        reviewed = (ROOT / m.HOME).read_bytes()
+        if reviewed == old:
+            self.skipTest('UI changes have not been written yet')
+
+        def seo(payload):
+            start = payload.index(b'    <title>')
+            end = payload.index(b'\n', payload.index(b'    <meta property="og:image"')) + 1
+            payload = payload[:start] + (
+                b"    {{-- STOREFRONT_SEO_HEAD_START --}}\n"
+                b"    @include('site.seo.head', ['seo' => \\App\\Services\\Site\\StorefrontSeo::homeMetadata()])\n"
+                b'    <meta name="theme-color" content="#091320">\n'
+                b"    {{-- STOREFRONT_SEO_HEAD_END --}}\n") + payload[end:]
+            payload = re.sub(rb'(<link rel="stylesheet" href="\{\{ asset\(\'storefront/storefront\.css\'\) \}\}[^\n]+\n)',
+                             lambda match: match[0] + b'    <link rel="stylesheet" href="/storefront/seo.css">\n', payload, count=1)
+            products = b'<a href="{{ \\App\\Services\\Site\\StorefrontSeo::url(\'/products\') }}">Products</a>'
+            payload = payload.replace(b'<a href="#story">', products + b'<a href="#story">', 1)
+            payload = payload.replace(b'<a href="#ordering-faq">', products + b'<a href="#ordering-faq">', 1)
+            payload = payload.replace('اللمة الحلوة،<br>تبدأ بـ'.encode(), 'فسيخ ورنجة،<br>بمزاج'.encode(), 1)
+            payload = payload.replace(b'    <section id="delivery"',
+                                      b"    @include('site.seo.home-products')\n    <section id=\"delivery\"", 1)
+            return payload
+
+        live = seo(old)
+        result = m.surgical_patch(live, old, reviewed)
+        self.assertEqual(result, seo(reviewed))
+        self.assertEqual(m.surgical_patch(result, old, reviewed), result)
+
+    def test_same_line_change_conflicts_without_partial_merge(self):
+        with self.assertRaisesRegex(RuntimeError, 'SOURCE_PATCH_CONFLICT'):
+            m.surgical_patch(b'A\nLIVE\nC\n', b'A\nB\nC\n', b'A\nREVIEWED\nC\n')
+        with self.assertRaisesRegex(RuntimeError, 'SOURCE_PATCH_CONFLICT'):
+            m.surgical_patch(b'A\nLIVE-INSERT\nB\n', b'A\nB\n', b'A\nREVIEWED-INSERT\nB\n')
+
+    def test_merge_inserts_deletes_and_keeps_boundary_insertions(self):
+        old = b'A\nB\nC\nD\n'
+        reviewed = b'A\nNEW\nD\n'
+        live = b'A\nBEFORE\nB\nC\nAFTER\nD\n'
+        self.assertEqual(m.surgical_patch(live, old, reviewed), b'A\nBEFORE\nNEW\nAFTER\nD\n')
+        self.assertEqual(m.surgical_patch(b'A\nB\nC\nD\nLIVE\n', old, b'A\nB\nD\n'),
+                         b'A\nB\nD\nLIVE\n')
+
+    def test_only_exact_known_assets_are_replaced_and_missing_files_refused(self):
+        for relative in m.ASSETS:
+            old = baseline(relative)
+            reviewed = old + b'\n/* reviewed UI */\n'
+            with mock.patch.object(m, 'source', side_effect=lambda root, revision, path:
+                                   old if revision == m.BASELINE else reviewed):
+                self.assertEqual(m.plan_target(ROOT, RELEASE, relative, old), reviewed)
+                self.assertEqual(m.plan_target(ROOT, RELEASE, relative, reviewed), reviewed)
+                with self.assertRaisesRegex(RuntimeError, 'ASSET_SOURCE_CONFLICT'):
+                    m.plan_target(ROOT, RELEASE, relative, old + b'\n/* live edit */\n')
+                with self.assertRaisesRegex(RuntimeError, 'STOREFRONT_FILE_MISSING'):
+                    m.plan_target(ROOT, RELEASE, relative, None)
+        with self.assertRaisesRegex(RuntimeError, 'FILE_NOT_REVIEWED'):
+            m.plan_target(ROOT, RELEASE, '.env', b'')
+
+    def test_bundle_verifies_six_exact_blobs_and_release_binding(self):
+        with tempfile.TemporaryDirectory() as directory:
+            bundle = pathlib.Path(directory)
+            manifest = {'schema': 1, 'release': RELEASE, 'baseline': m.BASELINE, 'blobs': {}}
+            for version in ('release', 'baseline'):
+                for relative in m.PUBLISH_ORDER:
+                    payload = (version + ':' + relative).encode()
+                    path = bundle / version / relative
+                    path.parent.mkdir(parents=True, exist_ok=True)
+                    path.write_bytes(payload)
+                    manifest['blobs'][version + '/' + relative] = m.blob(payload)
+            manifest_path = bundle / 'manifest.json'
+            manifest_path.write_text(json.dumps(manifest))
+            with mock.patch.object(m, 'BUNDLE_ROOT', bundle), mock.patch.object(m, 'owned_command') as command:
+                self.assertEqual(m.source(ROOT, RELEASE, m.HOME), ('release:' + m.HOME).encode())
+                self.assertEqual(m.source(ROOT, m.BASELINE, m.HOME), ('baseline:' + m.HOME).encode())
+                with self.assertRaisesRegex(RuntimeError, 'BUNDLE_REVISION_MISMATCH'):
+                    m.source(ROOT, 'e' * 40, m.HOME)
+                (bundle / 'release' / m.HOME).write_bytes(b'tampered')
+                with self.assertRaisesRegex(RuntimeError, 'SOURCE_BLOB_MISMATCH'):
+                    m.source(ROOT, RELEASE, m.HOME)
+                manifest['blobs']['release/.env'] = 'a' * 40
+                manifest_path.write_text(json.dumps(manifest))
+                with self.assertRaisesRegex(RuntimeError, 'BUNDLE_MANIFEST_INVALID'):
+                    m.source(ROOT, RELEASE, m.HOME)
+                command.assert_not_called()
+
+    def test_source_refuses_unreviewed_paths_before_git(self):
+        with mock.patch.object(m, 'owned_command') as command:
+            for revision, relative in ((RELEASE, '../.env'), ('HEAD', m.HOME)):
+                with self.assertRaisesRegex(RuntimeError, 'SOURCE_NOT_REVIEWED'):
+                    m.source(ROOT, revision, relative)
+            command.assert_not_called()
+
+    def test_snapshot_rejects_symlink_hardlink_and_writable_file(self):
+        with tempfile.TemporaryDirectory() as directory, mock.patch.object(m, 'safe_directories'):
+            path = pathlib.Path(directory) / 'asset'
+            path.write_bytes(b'original')
+            path.chmod(0o644)
+            original = m.snapshot(path, os.getuid())
+            self.assertEqual(original['bytes'], b'original')
+            path.chmod(0o666)
+            with self.assertRaisesRegex(RuntimeError, 'UNSAFE_FILE'):
+                m.snapshot(path, os.getuid())
+            path.chmod(0o644)
+            linked = path.with_name('hardlink')
+            os.link(path, linked)
+            with self.assertRaisesRegex(RuntimeError, 'UNSAFE_FILE'):
+                m.snapshot(path, os.getuid())
+            linked.unlink()
+            symbolic = path.with_name('symlink')
+            symbolic.symlink_to(path)
+            with self.assertRaisesRegex(RuntimeError, 'SYMLINK_PATH'):
+                m.snapshot(symbolic, os.getuid())
+
+    def stage(self, directory):
+        application = pathlib.Path(directory) / 'application'
+        application.mkdir()
+        originals, targets = {}, {}
+        for index, relative in enumerate(m.PUBLISH_ORDER):
+            originals[relative] = ('original asset %s\n' % index).encode()
+            targets[relative] = ('reviewed asset %s\n' % index).encode()
+            target = application / relative
+            target.parent.mkdir(parents=True, exist_ok=True)
+            target.write_bytes(originals[relative])
+            target.chmod(0o644)
+        return application, originals, targets
+
+    def test_preflight_only_lints_and_preserves_inode_and_no_backup(self):
+        with tempfile.TemporaryDirectory() as directory:
+            app, originals, targets = self.stage(directory)
+            before = {path: (app / path).stat() for path in m.PUBLISH_ORDER}
+            with mock.patch.object(m, 'safe_directories'), \
+                    mock.patch.object(m, 'plan_target', side_effect=lambda root, release, path, current: targets[path]), \
+                    mock.patch.object(m, 'owned_command', return_value=b'') as command, \
+                    mock.patch.object(m, 'backup_files', side_effect=AssertionError('preflight made backup')), \
+                    mock.patch.object(m, 'atomic', side_effect=AssertionError('preflight changed file')), \
+                    contextlib.redirect_stdout(io.StringIO()) as output:
+                m._install_locked(app, RELEASE, True, os.getuid())
+            self.assertIn('WEB_CUSTOMER_ADDRESSES_PREFLIGHT_OK', output.getvalue())
+            self.assertEqual(command.call_count, 1)
+            self.assertEqual(command.call_args.args[1][:2], [m.PHP, '-l'])
+            for path in m.PUBLISH_ORDER:
+                self.assertEqual((app / path).read_bytes(), originals[path])
+                self.assertEqual((app / path).stat(), before[path])
+            self.assertFalse((app.parent / 'web-customer-address-backups').exists())
+
+    def test_success_backs_up_exact_files_and_only_clears_views(self):
+        with tempfile.TemporaryDirectory() as directory:
+            app, originals, targets = self.stage(directory)
+            with mock.patch.object(m, 'safe_directories'), \
+                    mock.patch.object(m, 'plan_target', side_effect=lambda root, release, path, current: targets[path]), \
+                    mock.patch.object(m, 'owned_command', return_value=b'') as command, \
+                    contextlib.redirect_stdout(io.StringIO()) as output:
+                m._install_locked(app, RELEASE, False, os.getuid())
+            result = json.loads(output.getvalue())
+            self.assertEqual(result['status'], 'WEB_CUSTOMER_ADDRESSES_READY')
+            self.assertEqual(result['updated_files'], 3)
+            backup = pathlib.Path(result['backup'])
+            self.assertEqual(stat.S_IMODE(backup.stat().st_mode), 0o700)
+            for path in m.PUBLISH_ORDER:
+                self.assertEqual((app / path).read_bytes(), targets[path])
+                self.assertEqual((backup / path).read_bytes(), originals[path])
+                self.assertEqual(stat.S_IMODE((backup / path).stat().st_mode), 0o600)
+            self.assertEqual([call.args[1][2:] for call in command.call_args_list],
+                             [[command.call_args_list[0].args[1][2]], ['view:clear']])
+            self.assertEqual(command.call_args_list[1].args[1], [m.PHP, str(app / 'artisan'), 'view:clear'])
+
+    def test_view_clear_failure_rolls_back_all_files(self):
+        with tempfile.TemporaryDirectory() as directory:
+            app, originals, targets = self.stage(directory)
+            with mock.patch.object(m, 'safe_directories'), \
+                    mock.patch.object(m, 'plan_target', side_effect=lambda root, release, path, current: targets[path]), \
+                    mock.patch.object(m, 'owned_command', side_effect=[b'', RuntimeError('view failure'), b'']) as command:
+                with self.assertRaisesRegex(RuntimeError, 'WEB_CUSTOMER_ADDRESSES_ROLLED_BACK'):
+                    m._install_locked(app, RELEASE, False, os.getuid())
+            for path in m.PUBLISH_ORDER:
+                self.assertEqual((app / path).read_bytes(), originals[path])
+            self.assertEqual(command.call_count, 3)
+
+    def test_rollback_does_not_overwrite_new_concurrent_edits(self):
+        with tempfile.TemporaryDirectory() as directory:
+            app, originals, targets = self.stage(directory)
+            def command(root, arguments):
+                if arguments[-1] == 'view:clear':
+                    (app / m.HOME).write_bytes(b'independent concurrent edit')
+                    raise RuntimeError('view failure')
+                return b''
+            with mock.patch.object(m, 'safe_directories'), \
+                    mock.patch.object(m, 'plan_target', side_effect=lambda root, release, path, current: targets[path]), \
+                    mock.patch.object(m, 'owned_command', side_effect=command):
+                with self.assertRaisesRegex(RuntimeError, 'ROLLBACK_INCOMPLETE'):
+                    m._install_locked(app, RELEASE, False, os.getuid())
+            self.assertEqual((app / m.HOME).read_bytes(), b'independent concurrent edit')
+            for path in m.ASSETS:
+                self.assertEqual((app / path).read_bytes(), originals[path])
+
+    def test_rerun_exact_target_has_no_writes_or_backup(self):
+        with tempfile.TemporaryDirectory() as directory:
+            app, originals, _ = self.stage(directory)
+            with mock.patch.object(m, 'safe_directories'), \
+                    mock.patch.object(m, 'plan_target', side_effect=lambda root, release, path, current: current), \
+                    mock.patch.object(m, 'owned_command', return_value=b'') as command, \
+                    mock.patch.object(m, 'backup_files', side_effect=AssertionError('unnecessary backup')), \
+                    mock.patch.object(m, 'atomic', side_effect=AssertionError('unnecessary write')), \
+                    contextlib.redirect_stdout(io.StringIO()) as output:
+                m._install_locked(app, RELEASE, False, os.getuid())
+            self.assertEqual(json.loads(output.getvalue())['updated_files'], 0)
+            self.assertEqual(command.call_count, 1)
+
+    def test_fixed_root_and_release_are_enforced_before_actions(self):
+        with mock.patch.object(m, '_install_locked') as apply:
+            for root, revision in ((pathlib.Path('/tmp/other'), RELEASE), (m.APP_ROOT, 'HEAD'),
+                                   (m.APP_ROOT, m.BASELINE)):
+                with self.assertRaisesRegex(RuntimeError, 'FIXED_ROOT_RELEASE_REQUIRED'):
+                    m.install(root, revision)
+            apply.assert_not_called()
+
+
+if __name__ == '__main__':
+    unittest.main()
