+#!/usr/bin/env bash
+set -euo pipefail
+umask 077
+[[ "$(id -u)" == 0 ]] || { echo RUN_AS_ROOT; exit 1; }
+customer_addresses_root=/home/fasakha/public_html
+customer_addresses_revision="${1:?Full release SHA required}"
+[[ "$customer_addresses_revision" =~ ^[a-f0-9]{40}$ ]] || exit 1
+shift
+customer_addresses_flags=()
+for customer_addresses_flag in "$@"; do
+  case "$customer_addresses_flag" in
+    --check) [[ ${#customer_addresses_flags[@]} == 0 ]] || exit 1; customer_addresses_flags+=(--check) ;;
+    *) echo INVALID_OPTION; exit 1 ;;
+  esac
+done
+customer_addresses_tmp="$(mktemp -d /tmp/web-customer-addresses.XXXXXX)"
+trap 'rm -rf -- "$customer_addresses_tmp"' EXIT
+chmod 0755 "$customer_addresses_tmp"
+customer_addresses_helper=install_web_customer_addresses.py
+runuser -u fasakha -- git -C "$customer_addresses_root" show \
+  "$customer_addresses_revision:deployment/$customer_addresses_helper" > "$customer_addresses_tmp/$customer_addresses_helper"
+customer_addresses_blob="$(runuser -u fasakha -- git -C "$customer_addresses_root" rev-parse \
+  "$customer_addresses_revision:deployment/$customer_addresses_helper")"
+[[ "$(git hash-object --no-filters "$customer_addresses_tmp/$customer_addresses_helper")" == "$customer_addresses_blob" ]] || exit 1
+chmod 0644 "$customer_addresses_tmp/$customer_addresses_helper"
+python3 "$customer_addresses_tmp/$customer_addresses_helper" \
+  --root "$customer_addresses_root" --release "$customer_addresses_revision" "${customer_addresses_flags[@]}"
