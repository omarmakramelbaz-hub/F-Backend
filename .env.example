APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Meta Conversions API - server-side Purchase events
# Never commit the real META_ACCESS_TOKEN.
META_CONVERSIONS_ENABLED=false
META_DATASET_ID=1183070883497428
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v24.0
META_CURRENCY=EGP
META_APP_PLATFORM=android
META_ANDROID_PACKAGE=com.smartvision.faskhanista
META_IOS_BUNDLE_ID=com.faskhaninja.clients
META_APP_VERSION=
META_APP_BUILD=
META_APP_LOCALE=ar_EG
META_APP_TIMEZONE=Africa/Cairo
META_ADVERTISER_TRACKING_ENABLED=false
META_APPLICATION_TRACKING_ENABLED=false
META_TEST_EVENT_CODE=

# Paymob Mobile SDK / Intention API
# Keep real credentials in the server environment or GitHub secrets only.
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_ENVIRONMENT=production
